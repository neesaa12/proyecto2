# Copia este fichero a .env y rellena los valores en tu equipo.
# El programa no lee .env: exporta estas variables en tu sesión antes de ejecutar.

# Obligatoria: URL que ha dado el centro (endpoint de las peticiones).
TAREAS_IA_URL=
# Obligatoria: identificador exacto del modelo del centro.
TAREAS_IA_MODELO=
# Obligatoria: credencial del centro. No compartir este valor.
TAREAS_IA_CLAVE=
# Opcional: segundos de espera; si se deja vacío se usa 30.
TAREAS_IA_TIMEOUT=
# Opcional: ruta al certificado CA o al directorio de CA, si el centro usa CA propia.
TAREAS_IA_CA=
